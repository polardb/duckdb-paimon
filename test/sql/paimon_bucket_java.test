    (FALSE, -99, -25920, NULL, 1532230816302433446, '0.30687112'::FLOAT, '0.6710762488101574'::DOUBLE, DATE '1970-01-01' + (656823)::INTEGER, make_timestamp_ns(1988388716000000), '36.19', '3318076650490463209017982309.32', 'Alice_1318911071456810350', 'Two roads diverged in a wood, and I took the one less traveled by, And that has made all the difference -3370274031255729188.', 6580),
    (NULL, NULL, -32666, 873612482, 1527139015851636296, NULL, '0.25175545768906105'::DOUBLE, NULL, NULL, '23.76', '3829110624120332494774772650.63', NULL, 'Two roads diverged in a wood, and I took the one less traveled by, And that has made all the difference -2476551425607728309.', 155),
    (TRUE, -118, NULL, 731396580, NULL, '0.19061679'::FLOAT, '0.9043197434746348'::DOUBLE, DATE '1970-01-01' + (-435488)::INTEGER, NULL, '-28.89', '4786545537260784001844944973.28', 'Alice_1773398468402013874', 'Two roads diverged in a wood, and I took the one less traveled by, And that has made all the difference -2697084138585034005.', 7665),
    (NULL, NULL, -26856, 2077347671, -517428980255835422, '0.34984356'::FLOAT, NULL, NULL, make_timestamp_ns(-1550311379000000), '28.79', '-2358082207482465378166386831.59', 'Alice_-4749572426538882759', NULL, 8830),
    (FALSE, 39, 32700, -348690342, NULL, NULL, NULL, DATE '1970-01-01' + (-374250)::INTEGER, make_timestamp_ns(-1948015872000000), NULL, NULL, 'Alice_-417301880149921110', 'Two roads diverged in a wood, and I took the one less traveled by, And that has made all the difference -1365639961131482115.', 3607),
    (NULL, -60, 20953, -185358571, NULL, NULL, '0.7400275857342519'::DOUBLE, DATE '1970-01-01' + (181758)::INTEGER, make_timestamp_ns(1670927751000000), '6.48', '156960967219241110072414386.29', 'Alice_3087783559322503069', 'Two roads diverged in a wood, and I took the one less traveled by, And that has made all the difference 6982618520329021882.', 7262);

statement ok
ATTACH '__TEST_DIR__/java_buckets' AS pm (TYPE paimon);

statement ok
CREATE SCHEMA pm.d;

# Bucket-key order is independent of the physical table column order.
statement ok
CREATE TABLE pm.d.plain WITH ('bucket'='12345', 'bucket-key'='v0,v1,v2,v3,v4,v5,v6,v7,v8,v9,v10,v11,v12') AS SELECT expected_bucket, v12, v11, v10, v9, v8, v7, v6, v5, v4, v3, v2, v1, v0 FROM expected;

query I
SELECT count(*) FROM read_parquet('__TEST_DIR__/java_buckets/d.db/plain/bucket-*/*.parquet', filename=true) WHERE regexp_extract(filename, '/bucket-([0-9]+)/', 1)::INTEGER != expected_bucket;
----
0

query I
SELECT count(*) FROM pm.d.plain;
----
8

query I
SELECT count(*) FROM ((SELECT * FROM expected) EXCEPT ALL (SELECT v0,v1,v2,v3,v4,v5,v6,v7,v8,v9,v10,v11,v12, expected_bucket FROM pm.d.plain));
----
0

statement ok
CREATE TABLE pm.d.partitioned PARTITIONED BY (part) WITH ('bucket'='12345', 'bucket-key'='v0,v1,v2,v3,v4,v5,v6,v7,v8,v9,v10,v11,v12') AS SELECT *, CASE WHEN expected_bucket % 2 = 0 THEN 'even' ELSE NULL END AS part FROM expected WHERE false;

statement ok
INSERT INTO pm.d.partitioned BY NAME SELECT CASE WHEN expected_bucket % 2 = 0 THEN 'even' ELSE NULL END AS part, expected_bucket, v12, v11, v10, v9, v8, v7, v6, v5, v4, v3, v2, v1, v0 FROM expected;

query I
SELECT count(*) FROM read_parquet('__TEST_DIR__/java_buckets/d.db/partitioned/part=*/bucket-*/*.parquet', filename=true, hive_partitioning=false) WHERE regexp_extract(filename, '/bucket-([0-9]+)/', 1)::INTEGER != expected_bucket;
----
0

query I
SELECT count(*) FROM pm.d.partitioned;
----
8

query I
SELECT count(*) FROM ((SELECT * FROM expected) EXCEPT ALL (SELECT v0,v1,v2,v3,v4,v5,v6,v7,v8,v9,v10,v11,v12, expected_bucket FROM pm.d.partitioned));
----
0

# Non-NULL Java fixtures from record_for_bucket_id.data verify implicit PK ordering.
statement ok
CREATE TEMP TABLE pk_expected (
    v0 BOOLEAN, v1 TINYINT, v2 SMALLINT, v3 INTEGER, v4 BIGINT,
    v5 FLOAT, v6 DOUBLE, v7 DATE, v8 TIMESTAMP_NS,
    v9 DECIMAL(30,20), v10 VARCHAR, v11 BLOB, expected_bucket INTEGER
);

statement ok
