    (TRUE, -10, -4038, -1930858313, 2158390814503909950, '0.7815346'::FLOAT, '0.3332183994766498'::DOUBLE, DATE '1970-01-01' + (198467)::INTEGER, make_timestamp_ns(-1661998771000000), '548675771.00000000000000000000', 'Alice_-279624296851435688', 'Two roads diverged in a wood, and I took the one less traveled by, And that has made all the difference -3109364765729502342.', 4561),
    (FALSE, 15, -28048, 553609048, 6787954838522539928, '0.70517474'::FLOAT, '0.023238122483889456'::DOUBLE, DATE '1970-01-01' + (-436312)::INTEGER, make_timestamp_ns(39620447000000), '135992033.00000000000000000000', 'Alice_-655101936082782086', 'Two roads diverged in a wood, and I took the one less traveled by, And that has made all the difference 425784808157066482.', 2804),
    (FALSE, -101, 17098, -960731419, -429849028627267071, '0.6882345'::FLOAT, '0.4872328470301428'::DOUBLE, DATE '1970-01-01' + (-531620)::INTEGER, make_timestamp_ns(-81839914000000), '199671578.00000000000000000000', 'Alice_-4922475540349336432', 'Two roads diverged in a wood, and I took the one less traveled by, And that has made all the difference 4664870386390374308.', 10982);

statement ok
CREATE TABLE pm.d.pk_default (
    part VARCHAR, expected_bucket INTEGER, v11 BLOB, v10 VARCHAR, v9 DECIMAL(30,20),
    v8 TIMESTAMP_NS, v7 DATE, v6 DOUBLE, v5 FLOAT, v4 BIGINT, v3 INTEGER,
    v2 SMALLINT, v1 TINYINT, v0 BOOLEAN,
    PRIMARY KEY (v0,part,v1,v2,v3,v4,v5,v6,v7,v8,v9,v10,v11)
) PARTITIONED BY (part) WITH ('bucket'='12345');

statement ok
INSERT INTO pm.d.pk_default BY NAME SELECT *, 'p' AS part FROM pk_expected;

query I
SELECT count(*) FROM read_parquet('__TEST_DIR__/java_buckets/d.db/pk_default/part=*/bucket-*/*.parquet', filename=true, hive_partitioning=false) WHERE regexp_extract(filename, '/bucket-([0-9]+)/', 1)::INTEGER != expected_bucket;
----
0

query I
SELECT count(*) FROM pm.d.pk_default;
----
3

statement ok
INSERT INTO pm.d.pk_default BY NAME SELECT *, 'p' AS part FROM pk_expected;

query I
SELECT count(*) FROM pm.d.pk_default;
----
3
