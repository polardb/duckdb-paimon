# name: test/sql/paimon_bucket_java.test
# group: [sql]

require paimon

require parquet

# The first eight Java-generated rows from paimon-cpp's
# test/test_data/record_with_null_for_bucket_id.data, including expected bucket ids.
# Covers composite keys, NULLs, negative numbers, decimals, timestamps and binary data.
# Parse floating point values from strings to match Arrow JSON rounding, avoiding DECIMAL casts.
statement ok
CREATE TEMP TABLE expected (
    v0 BOOLEAN, v1 TINYINT, v2 SMALLINT, v3 INTEGER, v4 BIGINT,
    v5 FLOAT, v6 DOUBLE, v7 DATE, v8 TIMESTAMP_NS,
    v9 DECIMAL(5,2), v10 DECIMAL(30,2), v11 VARCHAR, v12 BLOB,
    expected_bucket INTEGER
);

statement ok
INSERT INTO expected VALUES
    (NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, 10663),
