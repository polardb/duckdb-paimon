Unsupported type as Hive bucket key type

# ARRAY exercises an unsupported bucket-key type that can be stored in a schema fixture.
statement ok
CREATE TABLE pm.d.default_type (id INTEGER[]);

statement ok
DETACH pm;

statement ok
COPY (SELECT '{"version":3,"id":0,"fields":[{"id":0,"name":"id","type":{"type":"ARRAY","element":"INT"}}],"highestFieldId":0,"partitionKeys":[],"primaryKeys":[],"options":{"bucket":"2","bucket-key":"id"},"timeMillis":0}') TO '__TEST_DIR__/ao_buckets/d.db/default_type/schema/schema-0' (FORMAT CSV, HEADER false, DELIMITER '\t', QUOTE '', ESCAPE '');

statement ok
ATTACH '__TEST_DIR__/ao_buckets' AS pm (TYPE paimon);

statement error
INSERT INTO pm.d.default_type DEFAULT VALUES;
----
Paimon default bucketing does not support bucket key type

query I
SELECT count(*) FROM glob(['__TEST_DIR__/ao_buckets/d.db/missing_key/snapshot/snapshot-*', '__TEST_DIR__/ao_buckets/d.db/unaware_key/snapshot/snapshot-*', '__TEST_DIR__/ao_buckets/d.db/unknown_key/snapshot/snapshot-*', '__TEST_DIR__/ao_buckets/d.db/partition_key/snapshot/snapshot-*', '__TEST_DIR__/ao_buckets/d.db/unknown_function/snapshot/snapshot-*', '__TEST_DIR__/ao_buckets/d.db/mod_keys/snapshot/snapshot-*', '__TEST_DIR__/ao_buckets/d.db/mod_type/snapshot/snapshot-*', '__TEST_DIR__/ao_buckets/d.db/hive_type/snapshot/snapshot-*', '__TEST_DIR__/ao_buckets/d.db/default_type/snapshot/snapshot-*']);
----
0

# Modulo bucketing also supports a single bucket.
statement ok
CREATE TABLE pm.d.mod_single (id INTEGER);

statement ok
DETACH pm;

statement ok
COPY (SELECT '{"version":3,"id":0,"fields":[{"id":0,"name":"id","type":"INT"}],"highestFieldId":0,"partitionKeys":[],"primaryKeys":[],"options":{"bucket":"1","bucket-key":"id","bucket-function.type":"mod"},"timeMillis":0}') TO '__TEST_DIR__/ao_buckets/d.db/mod_single/schema/schema-0' (FORMAT CSV, HEADER false, DELIMITER '\t', QUOTE '', ESCAPE '');

statement ok
ATTACH '__TEST_DIR__/ao_buckets' AS pm (TYPE paimon);

statement ok
INSERT INTO pm.d.mod_single VALUES (1);

query I
SELECT count(*) FROM pm.d.mod_single;
----
1
