mod bucketing requires exactly one INTEGER or BIGINT bucket key

statement ok
CREATE TABLE pm.d.mod_type (id VARCHAR);

statement ok
DETACH pm;

statement ok
COPY (SELECT '{"version":3,"id":0,"fields":[{"id":0,"name":"id","type":"STRING"}],"highestFieldId":0,"partitionKeys":[],"primaryKeys":[],"options":{"bucket":"2","bucket-key":"id","bucket-function.type":"mod"},"timeMillis":0}') TO '__TEST_DIR__/ao_buckets/d.db/mod_type/schema/schema-0' (FORMAT CSV, HEADER false, DELIMITER '\t', QUOTE '', ESCAPE '');

statement ok
ATTACH '__TEST_DIR__/ao_buckets' AS pm (TYPE paimon);

statement error
INSERT INTO pm.d.mod_type DEFAULT VALUES;
----
ModBucketFunction only supports INT or BIGINT

statement ok
CREATE TABLE pm.d.hive_type (id TIMESTAMP);

statement ok
DETACH pm;

statement ok
COPY (SELECT '{"version":3,"id":0,"fields":[{"id":0,"name":"id","type":"TIMESTAMP(6)"}],"highestFieldId":0,"partitionKeys":[],"primaryKeys":[],"options":{"bucket":"2","bucket-key":"id","bucket-function.type":"hive"},"timeMillis":0}') TO '__TEST_DIR__/ao_buckets/d.db/hive_type/schema/schema-0' (FORMAT CSV, HEADER false, DELIMITER '\t', QUOTE '', ESCAPE '');

statement ok
ATTACH '__TEST_DIR__/ao_buckets' AS pm (TYPE paimon);

statement error
