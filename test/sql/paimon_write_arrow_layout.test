# name: test/sql/paimon_write_arrow_layout.test
# group: [sql]

require paimon

statement ok
ATTACH '__TEST_DIR__/arrow_layout' AS pm (TYPE paimon);

statement ok
CREATE SCHEMA pm.d;

foreach format parquet orc

statement ok
CREATE TABLE pm.d.blob_${format} (f0 VARCHAR, f1 INTEGER, f2 BLOB, f3 BLOB);

statement ok
COPY (SELECT '{"version":3,"id":0,"fields":[{"id":0,"name":"f0","type":"STRING"},{"id":1,"name":"f1","type":"INT"},{"id":2,"name":"f2","type":"BLOB"},{"id":3,"name":"f3","type":"BLOB"}],"highestFieldId":3,"partitionKeys":[],"primaryKeys":[],"options":{"row-tracking.enabled":"true","data-evolution.enabled":"true","file.format":"${format}"},"timeMillis":0}'::BLOB) TO '__TEST_DIR__/arrow_layout/d.db/blob_${format}/schema/schema-0' (FORMAT BLOB);

endloop

statement ok
CREATE TABLE pm.d.ltz (id INTEGER, ts TIMESTAMP);

statement ok
COPY (SELECT '{"version":3,"id":0,"fields":[{"id":0,"name":"id","type":"INT"},{"id":1,"name":"ts","type":{"type":"ARRAY","element":"TIMESTAMP(3) WITH LOCAL TIME ZONE"}}],"highestFieldId":1,"partitionKeys":[],"primaryKeys":[],"options":{},"timeMillis":0}'::BLOB) TO '__TEST_DIR__/arrow_layout/d.db/ltz/schema/schema-0' (FORMAT BLOB);

statement ok
DETACH pm;

statement ok
ATTACH '__TEST_DIR__/arrow_layout' AS pm (TYPE paimon);

foreach format parquet orc

statement ok
INSERT INTO pm.d.blob_${format} VALUES ('a', 1, from_hex('0001ff'), NULL), ('b', 2, NULL, from_hex('deadbeef')), ('c', 3, ''::BLOB, from_hex('00ff00'));

query TITT
SELECT f0, f1, hex(f2), hex(f3) FROM pm.d.blob_${format} ORDER BY f1;
----
a	1	0001FF	NULL
b	2	NULL	DEADBEEF
c	3	(empty)	00FF00

endloop

statement error
INSERT INTO pm.d.ltz VALUES (1, NULL);
----
Cannot write TIMESTAMP WITH TIME ZONE[] to Paimon column "ts": DuckDB exports Arrow format "tsu:

statement ok
CREATE TABLE pm.d.settings (id INTEGER, s VARCHAR, b BLOB, d DECIMAL(10,2), t TIMESTAMPTZ, f BOOLEAN);

statement ok
SET arrow_large_buffer_size = true;

statement ok
INSERT INTO pm.d.settings VALUES (1, 'large offsets', from_hex('0001ff'), 1.25, TIMESTAMPTZ '2024-01-01 00:00:00+00', true);

statement ok
SET produce_arrow_string_view = true;

statement ok
SET arrow_output_version = '1.5';

statement ok
SET arrow_lossless_conversion = true;

statement ok
INSERT INTO pm.d.settings VALUES (2, 'string views longer than twelve bytes', from_hex('deadbeef'), 2.50, TIMESTAMPTZ '2024-01-01 00:00:00+00', false);

foreach format parquet orc

statement ok
INSERT INTO pm.d.blob_${format} SELECT i::VARCHAR, i, encode(i::VARCHAR), NULL FROM range(4, 5004) t(i);

query III
SELECT count(*), count(f3), count(*) FILTER (WHERE f0 = f1::VARCHAR AND f2 = encode(f0)) FROM pm.d.blob_${format} WHERE f1 >= 4;
----
5000	0	5000

endloop

statement ok
CREATE TABLE pm.d.settings_ctas WITH ('bucket'='2', 'bucket-key'='s') AS SELECT * FROM pm.d.settings;

query ITTTTT
SELECT id, s, hex(b), d, t = TIMESTAMPTZ '2024-01-01 00:00:00+00', f FROM pm.d.settings_ctas ORDER BY id;
----
1	large offsets	0001FF	1.25	true	true
2	string views longer than twelve bytes	DEADBEEF	2.50	true	false
