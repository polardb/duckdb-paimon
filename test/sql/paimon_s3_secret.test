# name: test/sql/paimon_s3_secret.test
# group: [sql]

require paimon

statement ok
CREATE SECRET paimon_s3_root (
    TYPE paimon,
    PROVIDER credential_chain,
    profile 'default',
    region 'ap-northeast-2',
    scope 's3://paimon-test'
);

statement ok
CREATE SECRET paimon_s3_warehouse (
    TYPE paimon,
    PROVIDER credential_chain,
    profile 'default',
    region 'ap-northeast-2',
    path_style_access false,
    scope 's3://paimon-test/warehouse'
);

query I
SELECT name FROM which_secret('s3://paimon-test/warehouse/db.db/table', 'paimon');
----
paimon_s3_warehouse

query I
SELECT provider FROM duckdb_secrets() WHERE name = 'paimon_s3_warehouse';
----
credential_chain

statement ok
CREATE SECRET paimon_s3_static (
    TYPE paimon,
    key_id 'key-id',
    secret 'secret-value',
    session_token 'session-token',
    region 'ap-northeast-2',
    scope 's3://static-test'
);

query I
SELECT count(*)
FROM duckdb_secrets()
WHERE name = 'paimon_s3_static'
  AND secret_string LIKE '%secret=redacted%'
  AND secret_string LIKE '%session_token=redacted%';
----
1
