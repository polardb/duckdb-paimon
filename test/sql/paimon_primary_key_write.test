# name: test/sql/paimon_primary_key_write.test
# group: [sql]

require paimon

require parquet

statement ok
ATTACH '__TEST_DIR__/pk_buckets' AS pm (TYPE paimon);

statement ok
CREATE SCHEMA pm.d;

# The default bucket key is the primary key, independent of physical column order.
statement ok
CREATE TABLE pm.d.plain (val VARCHAR, id BIGINT PRIMARY KEY) WITH ('bucket'='10', 'bucket-function.type'='mod');

statement ok
INSERT INTO pm.d.plain VALUES ('negative', -1), ('positive', 27), ('minimum', -9223372036854775808);

query TI
SELECT val, regexp_extract(filename, '/bucket-([0-9]+)/', 1)::INTEGER FROM read_parquet('__TEST_DIR__/pk_buckets/d.db/plain/bucket-*/*.parquet', filename=true) ORDER BY val;
----
minimum	2
negative	9
positive	7

# Plain INSERT applies the Paimon merge engine; deduplicate replaces existing keys.
statement ok
INSERT INTO pm.d.plain (id, val) VALUES (-1, 'replaced');

query IT
SELECT id, val FROM pm.d.plain ORDER BY id;
----
-9223372036854775808	minimum
-1	replaced
27	positive

# Partition columns are excluded from the implicit bucket key.
statement ok
CREATE TABLE pm.d.partitioned (val VARCHAR, id INTEGER, part VARCHAR, PRIMARY KEY(part, id)) PARTITIONED BY (part) WITH ('bucket'='10', 'bucket-function.type'='mod');

statement ok
INSERT INTO pm.d.partitioned BY NAME SELECT 'first' AS val, -1 AS id, 'a' AS part;

statement ok
INSERT INTO pm.d.partitioned VALUES ('second', -1, 'b'), ('updated', -1, 'a');

query TT
SELECT part, val FROM pm.d.partitioned ORDER BY part;
----
a	updated
b	second

query I
SELECT count(*) FROM read_parquet('__TEST_DIR__/pk_buckets/d.db/partitioned/part=*/bucket-*/*.parquet', filename=true, hive_partitioning=false) WHERE regexp_extract(filename, '/bucket-([0-9]+)/', 1)::INTEGER != 9;
----
0

# Explicit bucket keys may be a subset of the primary key, in a different order.
statement ok
CREATE TABLE pm.d.hive_bucket (s VARCHAR, i INTEGER, extra INTEGER, val VARCHAR, PRIMARY KEY(extra, s, i)) WITH ('bucket'='8', 'bucket-key'='i,s', 'bucket-function.type'='hive');

statement ok
INSERT INTO pm.d.hive_bucket VALUES ('hello', 7, 1, 'first'), ('hello', 7, 2, 'second');

query I
SELECT count(*) FROM pm.d.hive_bucket;
----
2

# Java Hive hash: ((0 * 31 + 7) * 31 + hash("hello")) & INT_MAX, modulo 8 = 3.
query I
SELECT count(*) FROM read_parquet('__TEST_DIR__/pk_buckets/d.db/hive_bucket/bucket-*/*.parquet', filename=true) WHERE regexp_extract(filename, '/bucket-([0-9]+)/', 1)::INTEGER != 3;
----
0

# COPY FROM after reattach uses the same routing and merge behavior.
statement ok
COPY (SELECT 'copied' AS val, -1::BIGINT AS id) TO '__TEST_DIR__/pk_copy.csv' (HEADER);

statement ok
DETACH pm;

statement ok
ATTACH '__TEST_DIR__/pk_buckets' AS pm (TYPE paimon);

statement ok
COPY pm.d.plain FROM '__TEST_DIR__/pk_copy.csv' (HEADER);

query T
SELECT val FROM pm.d.plain WHERE id = -1;
----
copied

# All primary-key columns, including partition columns, must be non-NULL.
statement error
INSERT INTO pm.d.plain (val) VALUES ('missing key');
----
Paimon primary-key columns cannot contain NULL

statement error
INSERT INTO pm.d.partitioned VALUES ('null partition', 1, NULL);
----
Paimon primary-key columns cannot contain NULL

statement error
INSERT INTO pm.d.plain VALUES ('returning', 4) RETURNING *;
----
INSERT RETURNING is not supported for Paimon primary-key tables

statement error
INSERT INTO pm.d.plain VALUES ('ignored', -1) ON CONFLICT DO NOTHING;
----
There are no UNIQUE/PRIMARY KEY constraints that refer to this table

statement error
INSERT OR REPLACE INTO pm.d.plain VALUES ('ignored', -1);
----
There are no UNIQUE/PRIMARY KEY constraints that refer to this table

statement error
UPDATE pm.d.plain SET val = 'ignored' WHERE id = -1;
----
Can only update base table

statement error
DELETE FROM pm.d.plain WHERE id = -1;
----
Can only delete from base table

query T
SELECT val FROM pm.d.plain WHERE id = -1;
----
copied

# Merge-engine semantics are delegated to paimon-cpp, not DuckDB uniqueness checks.
statement ok
CREATE TABLE pm.d.first_row (id INTEGER PRIMARY KEY, val VARCHAR) WITH ('bucket'='1', 'merge-engine'='first-row');

statement ok
INSERT INTO pm.d.first_row VALUES (1, 'first');

statement ok
INSERT INTO pm.d.first_row VALUES (1, 'second');

query T
SELECT val FROM pm.d.first_row;
----
first

statement ok
CREATE TABLE pm.d.partial_update (id INTEGER PRIMARY KEY, a VARCHAR, b VARCHAR) WITH ('bucket'='2', 'merge-engine'='partial-update');

statement ok
INSERT INTO pm.d.partial_update VALUES (1, 'a', 'b');

statement ok
INSERT INTO pm.d.partial_update (id, a) VALUES (1, 'updated');

query TT
SELECT a, b FROM pm.d.partial_update;
----
updated	b

statement ok
CREATE TABLE pm.d.aggregated (id INTEGER PRIMARY KEY, val INTEGER) WITH ('bucket'='2', 'merge-engine'='aggregation', 'fields.val.aggregate-function'='sum');

statement ok
INSERT INTO pm.d.aggregated VALUES (1, 2);

statement ok
INSERT INTO pm.d.aggregated VALUES (1, 3);

query I
SELECT val FROM pm.d.aggregated;
----
5

# Sequence fields, rather than arrival order, determine the surviving value.
statement ok
CREATE TABLE pm.d.sequenced (id INTEGER PRIMARY KEY, seq BIGINT, val VARCHAR) WITH ('bucket'='2', 'sequence.field'='seq');

statement ok
INSERT INTO pm.d.sequenced VALUES (1, 2, 'newer');

statement ok
INSERT INTO pm.d.sequenced VALUES (1, 1, 'older');

query T
SELECT val FROM pm.d.sequenced;
----
newer

# Shared fixed-bucket writers must merge concurrent chunks and subsequent commits.
statement ok
SET threads=4;

statement ok
CREATE TEMP TABLE pk_input AS SELECT i::INTEGER AS id FROM range(500000) r(i);

statement ok
CREATE TABLE pm.d.parallel_pk (id INTEGER PRIMARY KEY, val INTEGER) WITH ('bucket'='4', 'bucket-function.type'='mod');

statement ok
INSERT INTO pm.d.parallel_pk SELECT id, 1 FROM pk_input;

statement ok
INSERT INTO pm.d.parallel_pk SELECT id, 2 FROM pk_input;

query III
SELECT count(*), min(val), max(val) FROM pm.d.parallel_pk;
----
500000	2	2

query I
SELECT count(*) FROM read_parquet('__TEST_DIR__/pk_buckets/d.db/parallel_pk/bucket-*/*.parquet', filename=true) WHERE regexp_extract(filename, '/bucket-([0-9]+)/', 1)::INTEGER != id % 4;
----
0

# Invalid PK bucket keys fail before creating metadata.
statement error
CREATE TABLE pm.d.invalid_key (id INTEGER PRIMARY KEY, val INTEGER) WITH ('bucket'='2', 'bucket-key'='val');
----
must be a primary-key column

statement error
CREATE TABLE pm.d.invalid_partition (id INTEGER, part VARCHAR, PRIMARY KEY(id, part)) PARTITIONED BY (part) WITH ('bucket'='2', 'bucket-key'='part');
----
cannot be a partition key

statement error
CREATE TABLE pm.d.invalid_cross_partition (id INTEGER PRIMARY KEY, part VARCHAR) PARTITIONED BY (part) WITH ('bucket'='2');
----
require all partition keys in the primary key

statement error
CREATE TABLE pm.d.invalid_mod (id VARCHAR PRIMARY KEY) WITH ('bucket'='2', 'bucket-function.type'='mod');
----
ModBucketFunction only supports INT or BIGINT

query I
SELECT count(*) FROM glob('__TEST_DIR__/pk_buckets/d.db/invalid*/schema/*');
----
0
