# name: test/sql/paimon_snapshot_binding.test
# group: [sql]

# Every INSERT is a real commit. The callback test covers external commits
# between phases of ONE binding; PREPARE/EXECUTE deliberately rebinds.
require paimon

# Plan serialization is a separate contract: verification can rebind a scan
# without preserving its snapshot. These cases exercise a single live binding.
require no_alternative_verify

statement ok
ATTACH './data' AS bound_pm (TYPE paimon);

statement ok
DROP SCHEMA IF EXISTS bound_pm.__test_binding CASCADE;

statement ok
CREATE SCHEMA bound_pm.__test_binding;

statement ok
CREATE TABLE bound_pm.__test_binding.t (id INTEGER, value INTEGER);

query II
EXPLAIN SELECT * FROM bound_pm.__test_binding.t;
----
physical_plan	<REGEX>:.*Bound Snapshot:.*empty-at-bind.*Read Schema: 0.*

statement error
SELECT * FROM paimon_scan('./data/__test_binding.db/t', snapshot_from_id=1);
----
<REGEX>:.*(snapshot|Snapshot).*

query I
SELECT 42;
----
42

statement ok
INSERT INTO bound_pm.__test_binding.t VALUES (1,10),(2,20);

query II
EXPLAIN SELECT * FROM paimon_scan('./data/__test_binding.db/t');
----
physical_plan	<REGEX>:.*Bound Snapshot: 1.*Read Schema: 0.*

query II
EXPLAIN SELECT * FROM paimon_scan('./data', '__test_binding', 't');
----
physical_plan	<REGEX>:.*Bound Snapshot: 1.*Read Schema: 0.*

statement ok
PREPARE latest_direct AS SELECT * FROM paimon_scan('./data/__test_binding.db/t') ORDER BY id;

statement ok
PREPARE latest_catalog AS SELECT * FROM bound_pm.__test_binding.t ORDER BY id;

statement ok
PREPARE historical AS SELECT * FROM bound_pm.__test_binding.t AT (VERSION => 1) ORDER BY id;

statement ok
INSERT INTO bound_pm.__test_binding.t VALUES (3,30);

query II
EXECUTE latest_direct;
----
1	10
2	20
3	30

query II
EXECUTE latest_catalog;
----
1	10
2	20
3	30

query II
EXECUTE historical;
----
1	10
2	20

query II
EXPLAIN SELECT * FROM bound_pm.__test_binding.t AT (VERSION => 1);
----
physical_plan	<REGEX>:.*Bound Snapshot: 1.*Read Schema: 0.*

query II
SELECT * FROM paimon_scan('./data', '__test_binding', 't', snapshot_from_id=1) ORDER BY id;
----
1	10
2	20

query II
SELECT * FROM paimon_scan('./data/__test_binding.db/t', snapshot_from_timestamp=TIMESTAMP '2099-01-01') ORDER BY id;
----
1	10
2	20
3	30

query III
SELECT a.id,a.value,b.value FROM paimon_scan('./data/__test_binding.db/t',snapshot_from_id=1) a JOIN paimon_scan('./data/__test_binding.db/t',snapshot_from_id=2) b USING(id) ORDER BY a.id;
----
1	10	10
2	20	20

statement error
SELECT * FROM paimon_scan('./data/__test_binding.db/t',snapshot_from_id=99);
----
<REGEX>:.*(snapshot|Snapshot).*

statement error
SELECT * FROM paimon_scan('./data/__test_binding.db/t',snapshot_from_timestamp=TIMESTAMP '1900-01-01');
----
<REGEX>:.*snapshot.*

statement error
SELECT * FROM paimon_scan('./data/__test_binding.db/t',snapshot_from_id=1,snapshot_from_timestamp=TIMESTAMP '2099-01-01');
----
Cannot specify both

query I
SELECT count(*) FROM bound_pm.__test_binding.t WHERE id > 100;
----
0

query II
EXPLAIN SELECT * FROM paimon_scan('./data/__test_binding.db/t') WHERE id > 100;
----
physical_plan	<REGEX>:.*Bound Snapshot: 2.*Read Schema: 0.*

query I
SELECT 42;
----
42

statement ok
PREPARE parameterized_path AS SELECT * FROM paimon_scan($1) ORDER BY id;

statement ok
INSERT INTO bound_pm.__test_binding.t VALUES (4,40);

query II
EXECUTE parameterized_path('./data/__test_binding.db/t');
----
1	10
2	20
3	30
4	40

query II
EXECUTE latest_direct;
----
1	10
2	20
3	30
4	40

query II
EXECUTE latest_catalog;
----
1	10
2	20
3	30
4	40

# DuckDB 1.4 discards CREATE TABLE options. Install schema fixtures while
# detached, as in the existing v1.4 write tests, then exercise the real reader.
foreach option_table options other_branch empty_branch blank_branch empty_fallback blank_fallback fallback mode_latest mode_time mode_id invalid_id

statement ok
CREATE TABLE bound_pm.__test_binding.${option_table} (id INTEGER);

endloop

statement ok
DETACH bound_pm;

statement ok
CREATE TEMP MACRO binding_schema_fixture(options) AS '{"version":3,"id":0,"fields":[{"id":0,"name":"id","type":"INT"}],"highestFieldId":0,"partitionKeys":[],"primaryKeys":[],"options":' || options || ',"timeMillis":0}';

statement ok
COPY (SELECT binding_schema_fixture('{"scan.mode":"DEFAULT","scan.snapshot-id":"01"}')) TO './data/__test_binding.db/options/schema/schema-0' (FORMAT CSV, HEADER false, DELIMITER '\t', QUOTE '', ESCAPE '');

statement ok
COPY (SELECT binding_schema_fixture('{"branch":"audit"}')) TO './data/__test_binding.db/other_branch/schema/schema-0' (FORMAT CSV, HEADER false, DELIMITER '\t', QUOTE '', ESCAPE '');

statement ok
COPY (SELECT binding_schema_fixture('{"branch":""}')) TO './data/__test_binding.db/empty_branch/schema/schema-0' (FORMAT CSV, HEADER false, DELIMITER '\t', QUOTE '', ESCAPE '');

statement ok
COPY (SELECT binding_schema_fixture('{"branch":"   "}')) TO './data/__test_binding.db/blank_branch/schema/schema-0' (FORMAT CSV, HEADER false, DELIMITER '\t', QUOTE '', ESCAPE '');

statement ok
COPY (SELECT binding_schema_fixture('{"scan.fallback-branch":""}')) TO './data/__test_binding.db/empty_fallback/schema/schema-0' (FORMAT CSV, HEADER false, DELIMITER '\t', QUOTE '', ESCAPE '');

statement ok
COPY (SELECT binding_schema_fixture('{"scan.fallback-branch":"   "}')) TO './data/__test_binding.db/blank_fallback/schema/schema-0' (FORMAT CSV, HEADER false, DELIMITER '\t', QUOTE '', ESCAPE '');

statement ok
COPY (SELECT binding_schema_fixture('{"scan.fallback-branch":"main"}')) TO './data/__test_binding.db/fallback/schema/schema-0' (FORMAT CSV, HEADER false, DELIMITER '\t', QUOTE '', ESCAPE '');

statement ok
COPY (SELECT binding_schema_fixture('{"scan.mode":"latest","scan.snapshot-id":"1"}')) TO './data/__test_binding.db/mode_latest/schema/schema-0' (FORMAT CSV, HEADER false, DELIMITER '\t', QUOTE '', ESCAPE '');

statement ok
COPY (SELECT binding_schema_fixture('{"scan.mode":"from-timestamp","scan.snapshot-id":"1"}')) TO './data/__test_binding.db/mode_time/schema/schema-0' (FORMAT CSV, HEADER false, DELIMITER '\t', QUOTE '', ESCAPE '');

statement ok
COPY (SELECT binding_schema_fixture('{"scan.mode":"from-snapshot","scan.timestamp-millis":"1"}')) TO './data/__test_binding.db/mode_id/schema/schema-0' (FORMAT CSV, HEADER false, DELIMITER '\t', QUOTE '', ESCAPE '');

statement ok
COPY (SELECT binding_schema_fixture('{"scan.snapshot-id":"999999999999999999999999"}')) TO './data/__test_binding.db/invalid_id/schema/schema-0' (FORMAT CSV, HEADER false, DELIMITER '\t', QUOTE '', ESCAPE '');

statement ok
ATTACH './data' AS bound_pm (TYPE paimon);

# Uppercase modes and numeric table options retain native parsing compatibility.

statement ok
INSERT INTO bound_pm.__test_binding.options VALUES (1);

statement ok
INSERT INTO bound_pm.__test_binding.options VALUES (2);

query I
SELECT * FROM paimon_scan('./data/__test_binding.db/options');
----
1

query II
EXPLAIN SELECT * FROM paimon_scan('./data/__test_binding.db/options');
----
physical_plan	<REGEX>:.*Bound Snapshot: 1.*Read Schema: 0.*

# The native filesystem catalog currently ignores branch schema identifiers.
# Missing branches must still fail in the branch-aware scanner.
statement error
SELECT * FROM paimon_scan('./data/__test_binding.db/other_branch');
----
not found latest schema

statement error
SELECT * FROM bound_pm.__test_binding.other_branch;
----
not found latest schema

# Missing branches must fail instead of silently reading main's four rows.
statement error
SELECT * FROM paimon_scan('./data', '__test_binding', 't$branch_audit');
----
not found latest schema

statement error
SELECT * FROM paimon_scan('./data/__test_binding.db/t$branch_audit');
----
not found latest schema

statement error
SELECT * FROM bound_pm.__test_binding."t$branch_audit";
----
not found latest schema

# Explicit main is supported through every SQL entrypoint.
query II
SELECT * FROM paimon_scan('./data/__test_binding.db/t$branch_main') ORDER BY id;
----
1	10
2	20
3	30
4	40

query I
SELECT count(*) FROM paimon_scan('./data', '__test_binding', 't$branch_main');
----
4

query II
SELECT * FROM bound_pm.__test_binding."t$branch_main" AT (VERSION => 1) ORDER BY id;
----
1	10
2	20

# A suffix wins even when the schema option selects a nonexistent branch.
query I
SELECT count(*) FROM bound_pm.__test_binding."other_branch$branch_main";
----
0

query I
SELECT count(*) FROM paimon_scan('./data/__test_binding.db/other_branch$branch_main');
----
0

# Blank branch/fallback options preserve the default main read.
foreach option_table empty_branch blank_branch empty_fallback blank_fallback

statement ok
INSERT INTO bound_pm.__test_binding.${option_table} VALUES (7),(8);

query I
SELECT * FROM paimon_scan('./data/__test_binding.db/${option_table}') ORDER BY id;
----
7
8

query I
SELECT count(*) FROM paimon_scan('./data', '__test_binding', '${option_table}');
----
2

query I
SELECT * FROM bound_pm.__test_binding.${option_table} ORDER BY id;
----
7
8

endloop

statement error
SELECT * FROM paimon_scan('./data/__test_binding.db/fallback');
----
does not support a non-empty scan.fallback-branch

statement error
SELECT * FROM paimon_scan('./data', '__test_binding', 'fallback');
----
does not support a non-empty scan.fallback-branch

statement error
SELECT count(*) FROM bound_pm.__test_binding.fallback;
----
does not support a non-empty scan.fallback-branch

# Reject non-data schemas explicitly; paimon_snapshots has its own function.
statement error
SELECT count(*) FROM paimon_scan('./data/__test_binding.db/t$schemas');
----
requires a data-table schema

# Metadata remains available even when the reader is unsupported.
statement ok
CREATE TABLE bound_pm.__test_binding.unsupported_pk (id INTEGER PRIMARY KEY);

query IIIIII
DESCRIBE bound_pm.__test_binding.unsupported_pk;
----
id	INTEGER	YES	NULL	NULL	NULL

statement ok
CREATE VIEW unsupported_pk_view AS SELECT * FROM bound_pm.__test_binding.unsupported_pk;

statement error
SELECT * FROM unsupported_pk_view;
----
do not support pk table bucket=-1

statement error
SELECT count(*) FROM bound_pm.__test_binding.unsupported_pk;
----
do not support pk table bucket=-1

# Explicit modes cannot silently override conflicting effective selectors.
statement error
SELECT * FROM bound_pm.__test_binding.mode_latest;
----
scan.mode conflicts

statement error
SELECT * FROM bound_pm.__test_binding.mode_time;
----
scan.mode conflicts

statement error
SELECT * FROM bound_pm.__test_binding.mode_id;
----
scan.mode conflicts

statement error
SELECT * FROM paimon_scan('./data/__test_binding.db/invalid_id');
----
Invalid Paimon scan.snapshot-id

# Native DROP validates every stored schema's options, so restore the same
# fixture schema after the negative check to keep cleanup and reruns valid.
statement ok
DETACH bound_pm;

statement ok
COPY (SELECT binding_schema_fixture('{}')) TO './data/__test_binding.db/invalid_id/schema/schema-0' (FORMAT CSV, HEADER false, DELIMITER '\t', QUOTE '', ESCAPE '');

statement ok
DROP MACRO binding_schema_fixture;

statement ok
ATTACH './data' AS bound_pm (TYPE paimon);

# Historical data is projected using the latest schema captured at this bind.
# These are genuine schema-evolution histories already checked into the repo.
query IIT
SELECT * FROM paimon_scan('./data/schema_evolution.db/readded',snapshot_from_id=1);
----
1	10	NULL

query TII
SELECT * FROM paimon_scan('./data/schema_evolution.db/mixed_types',snapshot_from_id=1);
----
before	1	10

query II
EXPLAIN SELECT * FROM paimon_scan('./data/schema_evolution.db/mixed_types',snapshot_from_id=1);
----
physical_plan	<REGEX>:.*Bound Snapshot: 1.*Read Schema: 1.*

statement ok
DROP SCHEMA bound_pm.__test_binding CASCADE;

statement ok
DETACH bound_pm;
