# scalar index scan: equality hit
query II
SELECT idx, part FROM paimon_scan('./data/scalar_index.db/t1', debug_expected_splits=1) WHERE idx = 40;
----
40	0

# scalar index scan: range hit
query I
SELECT idx FROM paimon_scan('./data/scalar_index.db/t1', debug_expected_splits=1) WHERE idx BETWEEN 39 AND 41 ORDER BY idx;
----
40

# scalar index scan: filter on index column with non-index projection
query T
SELECT payload FROM paimon_scan('./data/scalar_index.db/t1', debug_expected_splits=1) WHERE idx = 40;
----
hit_40

# scalar index scan: missing point prunes every split during planning
query I
SELECT count(*) FROM paimon_scan('./data/scalar_index.db/t1', debug_expected_splits=0) WHERE idx = 44;
----
0
