# name: test/sql/scalar_index_scan.test
# group: [sql]

require paimon

# scalar index fixture: full scan covers three partition splits
query IIT
SELECT part, idx, payload FROM paimon_scan('./data/scalar_index.db/t1', debug_expected_splits=3) ORDER BY part, idx, payload;
